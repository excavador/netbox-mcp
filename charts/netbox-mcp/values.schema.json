{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "netbox-mcp values",
  "description": "Strict: a typo in a values file should fail the render, not be silently ignored and leave you wondering why a setting had no effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "netbox",
    "service",
    "auth",
    "proxy"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "repository"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Empty means the chart's appVersion. Pin it to upgrade deliberately rather than whenever the chart is republished."
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "netbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "existingSecret"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Base URL WITHOUT /api - the server appends /api itself.",
          "not": {
            "pattern": "/api/?$"
          }
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "description": "Required. The token is never a literal in values: it would end up in a values file, in git, and in `helm get values` output."
        },
        "existingSecretTokenKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "The resource-proxy's listen port; the Service targets it and no other port of the pod."
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerUrl",
        "resourceUrl"
      ],
      "properties": {
        "issuerUrl": {
          "type": "string",
          "minLength": 1,
          "description": "The issuer's own URL, exactly as it appears in a token's `iss`. Feeds the resource-proxy. https."
        },
        "resourceUrl": {
          "type": "string",
          "minLength": 1,
          "description": "This server's own EXTERNAL URL: the RFC 8707 resource indicator a client names, and the `aud` the resource-proxy requires. Its path is where the proxy serves the server. Must equal this resource's id in the issuer's policy, byte for byte."
        },
        "scope": {
          "type": "string",
          "description": "Advertised in the PRM's scopes_supported and the 401 challenge's scope; never checked. Empty omits both fields rather than advertising an empty list."
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "deploymentAnnotations": {
      "type": "object",
      "description": "Annotations on the Deployment itself. Reloader reads them here, not on the pod template.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "description": "REQUIRED, no default: the resource-proxy is built by another repository's release, so pin the one you have verified. No leading v."
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "REQUIRED, no default: sha256:<64 hex>, the image index digest. Pinned with the tag so a moved tag cannot change what guards the server."
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "description": "NetworkPolicy peers admitted to the proxy's port, verbatim (a peer may combine a namespaceSelector and a podSelector). Required while enabled."
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": {
              "type": "array"
            },
            "https": {
              "type": "array"
            },
            "netbox": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "type": "array"
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            }
          }
        },
        "extraEgress": {
          "type": "array"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        }
      }
    }
  }
}
